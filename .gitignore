# ---- Secrets: never upload these to GitHub ----
# API keys, tokens and passwords go in a .env / .dev.vars file on your own
# machine, or in GitHub Actions / Cloudflare secrets. These files stay local.
.env
.env.*
*.env
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
key.properties
google-services.json
GoogleService-Info.plist
service-account*.json
credentials*.json
*.pem
*.p12
*.key

# Signing keys never belong on the website
*.jks
*.keystore
